{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carlos-dataengineer/fluxoorg/schema/fluxoorg.schema.json",
  "title": "Spec do Fluxoorg",
  "description": "Descrição de uma reunião que o Fluxoorg transforma em quadro. Veja skills/fluxoorg/references/FORMATO.md. O app também aceita as chaves equivalentes em inglês.",
  "type": "object",
  "required": ["fluxos"],
  "properties": {
    "titulo": {"type": "string", "description": "Título do quadro e nome da aba"},
    "resumo": {"type": "string", "description": "Conclusão principal em até 10 palavras"},
    "data": {"type": "string", "description": "Data da reunião (dd/mm/aaaa)"},
    "participantes": {"type": "array", "items": {"type": "string"}},
    "fluxos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["etapas"],
        "properties": {
          "titulo": {"type": "string"},
          "etapas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {"type": "string"},
                {
                  "type": "object",
                  "required": ["texto"],
                  "properties": {
                    "id": {"type": "string"},
                    "texto": {"type": "string", "minLength": 1},
                    "tipo": {"enum": ["etapa", "sistema", "condicao"]},
                    "raia": {"type": "string"}
                  }
                }
              ]
            }
          },
          "ligacoes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["de", "para"],
              "properties": {
                "de": {"type": "string"},
                "para": {"type": "string"},
                "rotulo": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "quadros": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["itens"],
        "properties": {
          "titulo": {"type": "string"},
          "tipo": {"enum": ["dor", "decisao", "pendencia", "regra", "necessidade"]},
          "itens": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "tabelas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["colunas", "linhas"],
        "properties": {
          "titulo": {"type": "string"},
          "colunas": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "linhas": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
        }
      }
    }
  }
}
